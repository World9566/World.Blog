{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "world-blog-status",
  "main": "index.mjs",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "preview_urls": false,
  "dev": { "ip": "127.0.0.1" },
  "vars": {
    "MAIN_ORIGIN": "https://www.world9566.online",
    "STATUS_ORIGIN": "https://status.world9566.online",
  },
  "routes": [
  { "pattern": "status.world9566.online", "custom_domain": true },
  { "pattern": "www.world9566.online/*", "zone_name": "world9566.online" }
],
  "triggers": { "crons": ["* * * * *"] },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "world-blog-status",
      "database_id": "212c516a-ea07-4af6-965b-288c7a7ae20e",
      "migrations_dir": "migrations",
    },
  ],
}
