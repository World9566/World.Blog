{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "world-blog-status",
  "main": "index.mjs",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "preview_urls": false,
  "dev": { "ip": "127.0.0.1" },
  "vars": {
    "MAIN_ORIGIN": "https://www.world9566.online",
    "STATUS_ORIGIN": "https://status.world9566.online",
  },
  "routes": [{ "pattern": "status.world9566.online", "custom_domain": true }],
  "triggers": { "crons": ["* * * * *"] },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "world-blog-status",
      // Replace with the ID returned by `wrangler d1 create world-blog-status`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
