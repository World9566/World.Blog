COMPOSE_PROJECT_NAME=world-blog
SITE_URL=https://www.world9566.online
SITE_HOST=www.world9566.online
ORIGIN_PORT=8080
BLOG_IMAGE=ghcr.nju.edu.cn/your-account/your-blog
BLOG_RELEASE=not-deployed
GATEWAY_IMAGE=ghcr.nju.edu.cn/your-account/your-blog:nginx-1.28.2-alpine
POSTGRES_IMAGE=ghcr.nju.edu.cn/your-account/your-blog:postgres-18.6-bookworm
MEILI_IMAGE=ghcr.nju.edu.cn/your-account/your-blog:meilisearch-1.53.2

POSTGRES_USER=blog
POSTGRES_DB=blog
# Keep generated passwords as hexadecimal so the database URL needs no escaping.
POSTGRES_PASSWORD=
MEILI_MASTER_KEY=
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Content releases: mounted read-only into web/ops as /content. Created by
# scripts/ops/init-env.sh as a sibling of the application directory.
CONTENT_ROOT=/home/deploy/apps/world-blog-content
CONTENT_REFRESH_TOKEN=
