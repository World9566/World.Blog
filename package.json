{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "pnpm db:generate && pnpm content:validate && next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "pnpm db:generate && pnpm content:validate && next typegen && tsc --noEmit",
    "content:validate": "tsx scripts/content.ts",
    "content:release-check": "tsx scripts/content-release-check.ts",
    "content:check": "node scripts/check-content.mjs",
    "search:sync": "tsx scripts/search-sync.ts",
    "search:prepare": "tsx scripts/search-sync.ts prepare",
    "search:swap": "tsx scripts/search-sync.ts swap",
    "test": "tsx --test tests/*.test.ts",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "user:access": "node --conditions=react-server --import tsx scripts/user-access.ts",
    "auth:check": "node --conditions=react-server --import tsx scripts/check-auth.ts",
    "community:check": "node --conditions=react-server --import tsx scripts/check-community.ts",
    "admin:check": "node --conditions=react-server --import tsx scripts/check-admin.ts",
    "env:check": "node scripts/check-env.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.3.5",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.5",
    "dotenv": "17.4.2",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "mdast-util-to-string": "4.0.0",
    "meilisearch": "0.62.0",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-pretty-code": "0.14.5",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "server-only": "0.0.1",
    "shiki": "4.4.3",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
